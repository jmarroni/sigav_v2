# SIGAV v2 — dominio canónico de la sucursal (sirve la app)
{$APP_DOMAIN} {
	encode gzip
	reverse_proxy app:80
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Apex / aliases → redirigen (308) al dominio canónico.
# APP_APEX debe estar seteado en el .env (ej: sigav.ar). Acepta varios
# hosts separados por coma. Si no usás apex, dejá APP_APEX = APP_DOMAIN.
{$APP_APEX} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

# Mercado Artesanal — segunda instancia de SIGAV en la misma VM (ver
# deploy/mercado/). El alias mercado-artesanal.sigav.ar es la pre-producción:
# se prueba ahí con HTTPS real antes de apuntar el dominio definitivo.
# Caddy emite el certificado solo (Cloudflare en DNS only).
# CUTOVER: cuando el A de sistema.mercado-artesanal.com.ar apunte a esta VM,
# agregar ese host a la cabecera del bloque (coma-separado) y `caddy reload`.
# No antes: con el DNS todavía en Ferozo, ACME falla y Let's Encrypt limita
# los reintentos por hostname.
mercado-artesanal.sigav.ar {
	encode gzip
	reverse_proxy mercado_app:80
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
