# SIGAV v2 — dominio canónico de la sucursal (sirve la app)
{$APP_DOMAIN} {
	encode gzip
	reverse_proxy app:80
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Apex (sigav.ar) → sitio institucional estático.
# APP_APEX debe estar seteado en el .env (ej: sigav.ar). Acepta varios
# hosts separados por coma. Si no usás apex, dejá APP_APEX = APP_DOMAIN.
{$APP_APEX} {
	encode gzip
	root * /srv/institucional
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
