# === .env de PRODUCCIÓN (copiar a /opt/sigav/.env y completar) ===
APP_NAME=SIGAV
APP_ENV=production
APP_KEY=                      # generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://CAMBIAR-dominio
# Dominio canónico que sirve la app (Caddy le saca el cert). Ej: acantilado-sur.sigav.ar
APP_DOMAIN=CAMBIAR-dominio
# Apex / aliases que redirigen (308) al canónico. Coma-separado. Si no usás
# apex, poné el mismo valor que APP_DOMAIN. Ej: sigav.ar
APP_APEX=CAMBIAR-apex
FRONTEND_URL=https://CAMBIAR-dominio

LOG_CHANNEL=stack

# --- Base de datos (Laravel + compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sigav
DB_USERNAME=sigav
DB_PASSWORD=CAMBIAR_password_fuerte_app
DB_ROOT_PASSWORD=CAMBIAR_password_fuerte_root

# --- Legacy (public/conection.php) — deben coincidir con los de arriba ---
LEGACY_DB_HOST=db
LEGACY_DB_USER=sigav
LEGACY_DB_PASS=CAMBIAR_password_fuerte_app
LEGACY_DB_NAME=sigav

# Puente de auth legacy->Laravel (middleware LegacyCookieAuth). public/conection.php
# lee esta MISMA variable como SEMILLA, así que hay una única fuente; si falta,
# las rutas Laravel (/carga, etc.) rebotan al login.
# Semilla de hashes legacy. Valor secreto: tomarlo del gestor de secretos / .env actual de la VM, NUNCA commitearlo.
LEGACY_SEMILLA=

# Chat Smartsupp en el header legacy (opcional; vacío = deshabilitado)
SMARTSUPP_KEY=
# Guard del importador de catálogo: solo true en una instancia que arranca vacía
CATALOGO_IMPORTAR_PERMITIDO=false

# --- API legacy ---
API_SECRET_KEY=              # generar con: php -r "echo bin2hex(random_bytes(32));"

# --- Backups ---
BACKUP_BUCKET=gs://CAMBIAR-bucket
