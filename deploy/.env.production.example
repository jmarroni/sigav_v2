###############################################################################
# Plantilla de entorno para PRODUCCIÓN (Google Cloud).
# Copiala como `.env` en el servidor y completá los valores marcados con <...>.
# NO commitees el archivo .env con datos reales.
###############################################################################

APP_NAME=SIGAV
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<TU-DOMINIO.com>

# Clave secreta de la API (generá una cadena larga y aleatoria)
API_SECRET_KEY=<CADENA_ALEATORIA_FUERTE>

# URL del frontend para CORS (si aplica). En general es el mismo dominio.
FRONTEND_URL=https://<TU-DOMINIO.com>

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Base de datos (MySQL instalado en la misma VM) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sigav
DB_USERNAME=sigav
DB_PASSWORD=<LA_CONTRASEÑA_QUE_ELEGISTE>

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo saliente (completá con tu proveedor SMTP real) ---
MAIL_MAILER=smtp
MAIL_HOST=<smtp.tu-proveedor.com>
MAIL_PORT=587
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<no-reply@tu-dominio.com>
MAIL_FROM_NAME="${APP_NAME}"

# --- Almacenamiento AWS S3 (opcional, solo si lo usás) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# --- Pusher (opcional, solo si usás websockets) ---
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Integración Mercado Libre (completá si la vas a usar) ---
ML_APP_ID=<APP_ID_DE_MERCADO_LIBRE>
ML_SECRET_KEY=<SECRET_DE_MERCADO_LIBRE>
ML_REDIRECT_URI=https://<TU-DOMINIO.com>/mercadolibre/callback
