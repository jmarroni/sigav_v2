# .env de la instancia de Mercado Artesanal (copiar a /opt/mercado/.env en la VM).
# Es el .env de Laravel Y el archivo que lee docker compose (--env-file .env).
# Ningún valor real acá: los secretos viven solo en la VM.

APP_NAME="Mercado Artesanal"
APP_ENV=production
# MISMO APP_KEY que tenía el .env de Ferozo (no generar uno nuevo).
APP_KEY=
APP_DEBUG=false
APP_URL=https://sistema.mercado-artesanal.com.ar
# Dominio canónico + alias de pre-producción (Caddy los toma del Caddyfile,
# no de acá; APP_URL/FRONTEND_URL sí los usa Laravel).
FRONTEND_URL=https://sistema.mercado-artesanal.com.ar

LOG_CHANNEL=stack

# --- Base de datos: MySQL compartido de Acantilado (contenedor sigav_db) ---
DB_CONNECTION=mysql
DB_HOST=sigav_db
DB_PORT=3306
DB_DATABASE=mercado
DB_USERNAME=mercado
DB_PASSWORD=CAMBIAR_password_fuerte_mercado
# La base de Mercado guarda bytes UTF-8 en columnas latin1 (herencia del POS
# legacy, que conecta sin set_charset). Laravel debe conectar en latin1 para
# leer/escribir esos bytes sin convertirlos; con utf8mb4 se ve "NIÃ‘EZ".
DB_CHARSET=latin1
DB_COLLATION=latin1_swedish_ci

# --- Legacy (public/conection.php). Misma semilla que en Ferozo: las claves
# sha1 de los 29 usuarios y las cookies dependen de ella. Comillas simples. ---
LEGACY_SEMILLA=

# --- API legacy (borrados con header). Generar: php -r "echo bin2hex(random_bytes(32));" ---
API_SECRET_KEY=

# --- Mail saliente (PHPMailer legacy). Vacío = los envíos fallan con mensaje genérico. ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Mercado Artesanal"

# Chat Smartsupp (opcional; vacío = no se carga)
SMARTSUPP_KEY=

# NUNCA true en Mercado: el importador borra ventas, facturas, stock y productos.
CATALOGO_IMPORTAR_PERMITIDO=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Red de Caddy (default correcto en la VM)
CADDY_NETWORK=sigav_sigav
